{
  "name": "imgbb-gallery",
  "version": "1.0.0",
  "scripts": {
    "server": "node server/server.js",
    "server:watch": "npm run dev --prefix server",
    "client": "live-server client --port=5500",
    "dev": "concurrently \"npm run server:watch\" \"npm run client\"",
    "seed:folders": "node scripts/create-folder-structure.js",
    "parse:mya": "node scripts/parse-mya-stages.js",
    "import:mya": "node scripts/import-mya-stages.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "live-server": "^1.2.2"
  }
}
